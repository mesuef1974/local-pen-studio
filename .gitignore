# Keep source, project documentation and intentional fixtures only.
/*
!/.gitignore
!/README.md
!/*.py
!/*.html
!/local-ai-report-*.png
!/models-guide-*.png
!/local-ai-report-sources.json
!/models-evidence.json
!/drawing-simulator/
/drawing-simulator/*
!/drawing-simulator/*.py
!/drawing-simulator/*.js
!/drawing-simulator/*.cjs
!/drawing-simulator/*.css
!/drawing-simulator/*.html
!/drawing-simulator/requirements*.txt
!/drawing-simulator/reference-benchmark/
/drawing-simulator/reference-benchmark/*
!/drawing-simulator/reference-benchmark/reference.png
!/drawing-simulator/reference-benchmark/reference.svg
!/drawing-simulator/reference-benchmark/reference-definition.json
!/drawing-simulator/reference-benchmark/provenance.json
!/drawing-simulator/reference-benchmark/results.json
!/drawing-simulator/reference-benchmark/report-ar.html
!/drawing-simulator/reference-benchmark/centerline-render.png
!/drawing-simulator/reference-benchmark/edges-render.png
!/drawing-simulator/reference-benchmark/centerline-output.svg
!/drawing-simulator/reference-benchmark/centerline-paths.json
!/drawing-simulator/reference-benchmark/edges-paths.json
!/drawing-simulator/photo-lineart-comparison/
/drawing-simulator/photo-lineart-comparison/*
!/drawing-simulator/photo-lineart-comparison/original.png

# Local runtimes, model weights, secrets and generated outputs stay local.
**/.env
**/.env.*
**/__pycache__/
**/.venv*/
**/models/
**/*.log
**/*.pem
**/*.key
**/.DS_Store
